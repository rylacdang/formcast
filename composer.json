{
    "name": "rylacdang/formcast",
    "description": "Cast your Laravel FormRequest rules to typed Zod schemas, TypeScript types, and Laravel-identical error messages.",
    "keywords": [
        "laravel",
        "formcast",
        "validation",
        "form-request",
        "zod",
        "typescript",
        "inertia",
        "precognition"
    ],
    "homepage": "https://github.com/rylacdang/formcast",
    "license": "MIT",
    "authors": [
        {
            "name": "Ryan Lester Lacdang",
            "homepage": "https://github.com/rylacdang",
            "role": "Software Developer"
        }
    ],
    "require": {
        "php": "^8.3",
        "illuminate/console": "^12.0 || ^13.0",
        "illuminate/routing": "^12.0 || ^13.0",
        "illuminate/support": "^12.0 || ^13.0",
        "illuminate/validation": "^12.0 || ^13.0",
        "spatie/laravel-package-tools": "^1.93",
        "symfony/finder": "^7.0 || ^8.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.20",
        "orchestra/testbench": "^10.0 || ^11.0",
        "pestphp/pest": "^3.0 || ^4.0",
        "pestphp/pest-plugin-arch": "^3.0 || ^4.0",
        "pestphp/pest-plugin-laravel": "^3.0 || ^4.0",
        "spatie/pest-plugin-snapshots": "^2.2"
    },
    "autoload": {
        "psr-4": {
            "Rylacdang\\Formcast\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Rylacdang\\Formcast\\Tests\\": "tests/",
            "Workbench\\App\\": "workbench/app/"
        }
    },
    "scripts": {
        "test": "vendor/bin/pest",
        "test-coverage": "vendor/bin/pest --coverage",
        "analyse": "vendor/bin/phpstan analyse",
        "format": "vendor/bin/pint",
        "format:check": "vendor/bin/pint --test"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Rylacdang\\Formcast\\FormcastServiceProvider"
            ],
            "aliases": {
                "Formcast": "Rylacdang\\Formcast\\Facades\\Formcast"
            }
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
