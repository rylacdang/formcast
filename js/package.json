{
  "name": "@rylacdang/formcast",
  "version": "0.0.0",
  "description": "Cast your Laravel FormRequest rules to typed Zod schemas, TypeScript types, and Laravel-identical error messages.",
  "license": "MIT",
  "author": {
    "name": "Ryan Lester Lacdang",
    "url": "https://github.com/rylacdang"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/rylacdang/formcast.git",
    "directory": "js"
  },
  "homepage": "https://github.com/rylacdang/formcast#readme",
  "bugs": {
    "url": "https://github.com/rylacdang/formcast/issues"
  },
  "keywords": [
    "laravel",
    "formcast",
    "validation",
    "zod",
    "typescript",
    "inertia",
    "precognition",
    "vue",
    "react",
    "vite"
  ],
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./vite": {
      "types": "./dist/vite/index.d.ts",
      "import": "./dist/vite/index.js",
      "require": "./dist/vite/index.cjs"
    },
    "./vue": {
      "types": "./dist/vue/index.d.ts",
      "import": "./dist/vue/index.js",
      "require": "./dist/vue/index.cjs"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react/index.js",
      "require": "./dist/react/index.cjs"
    }
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run --exclude tests/parity/**",
    "test:watch": "vitest --exclude tests/parity/**",
    "test:parity": "vitest run tests/parity",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@inertiajs/react": ">=2.3.0",
    "@inertiajs/vue3": ">=2.3.0",
    "react": "^18.0.0 || ^19.0.0",
    "vite": ">=6.0.0",
    "vue": "^3.4.0",
    "zod": "^4.0.0"
  },
  "peerDependenciesMeta": {
    "@inertiajs/react": {
      "optional": true
    },
    "@inertiajs/vue3": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "vite": {
      "optional": true
    },
    "vue": {
      "optional": true
    }
  },
  "devDependencies": {
    "@eslint/js": "^9.25.0",
    "@inertiajs/react": "^2.3.0 || ^3.0.0",
    "@inertiajs/vue3": "^2.3.0 || ^3.0.0",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@vue/test-utils": "^2.4.6",
    "eslint": "^9.25.0",
    "eslint-config-prettier": "^10.1.0",
    "happy-dom": "^17.0.0",
    "prettier": "^3.5.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsup": "^8.5.0",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.30.0",
    "vite": "^8.3.8",
    "vitest": "^3.2.0",
    "vue": "^3.5.0",
    "zod": "^4.0.0"
  }
}
