z.object({
  avatar: fc.required(fc.file(m['avatar.file']).refine(fc.fileMaxKb(2048), m['avatar.max']).refine(fc.isImage, m['avatar.image']), m['avatar.required']),
  items: fc.required(z.array(fc.optional(z.object({
      product_id: fc.required(fc.integer(m['items.*.product_id.integer']), m['items.*.product_id.required']),
      quantity: fc.required(fc.integer(m['items.*.quantity.integer']).min(1, m['items.*.quantity.min']).max(99, m['items.*.quantity.max']), m['items.*.quantity.required']),
    }))).min(1, m['items.min']), m['items.required']),
  password: fc.required(fc.string().min(8, m['password.min']).regex(/\p{L}/u, m['password.password.letters']).refine(fc.isMixedCase, m['password.password.mixed']).regex(/\p{N}/u, m['password.password.numbers']).regex(/[\p{Z}\p{S}\p{P}]/u, m['password.password.symbols']), m['password.required']),
})